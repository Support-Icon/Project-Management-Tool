# FastAPI backend. From this folder run:
#   python -m venv .venv
#   .venv\Scripts\activate
#   pip install -r requirements.txt
#   uvicorn app.main:app --reload --port 5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/test
JWT_SECRET=your-super-secret-key-change-this
PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ENCRYPTION_KEY=64-character-hex-key-used-to-encrypt-email-and-ai-api-keys
CRON_SECRET=long-random-secret-for-digest-scheduler
# On AWS Lambda these are set by GitHub Actions from repository secrets.
# PORT=8080 is used inside the container image.
